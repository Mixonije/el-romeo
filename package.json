{
  "name": "el-romeo",
  "version": "1.0.0",
  "main": "worker/index.js",
  "scripts": {
    "dev": "wrangler d1 migrations apply el-romeo --local && wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply el-romeo --remote",
    "test": "node test/api.test.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "seed-sql": "node scripts/seed-sql.mjs"
  },
  "description": "Booking app for El Romeo barbershop in Zürich",
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "type": "module",
  "devDependencies": {
    "wrangler": "^4.86.0"
  }
}
